# .env.priavate 넣고 git push에서 제외합니다.
VISANG_USERNAME=00000
VISANG_PASSWORD=00000

START_HOUR_MIN=8
START_HOUR_MAX=12
END_HOUR_MIN=18
END_HOUR_MAX=24

HOLIDAY_ICS_URL=https://calendar.google.com/calendar/ical/ko.south_korea%23holiday%40group.v.calendar.google.com/public/basic.ics
# public = 공휴일만 제외 / all = 캘린더의 모든 일정(기념일 포함) 제외
HOLIDAY_SKIP_MODE=public

# 내 캘린더 비밀 iCal 주소는 .env.private 의 LEAVE_ICS_URL 에 넣으세요.
# 제목에 아래 키워드가 포함된 일정은 실행 제외 (쉼표 구분)
LEAVE_KEYWORDS=연차,반차

# 로그인 폼 셀렉터
SELECTOR_INPUT_ID=S_USER_ID
SELECTOR_INPUT_PW=S_PWD
SELECTOR_BTN_LOGIN=btn_login

# 출퇴근 시간 요소 셀렉터
SELECTOR_IN_TIME=C_IN_HM_DP
SELECTOR_OUT_TIME=C_OUT_HM_DP
SELECTOR_BTN_STA=S_WORK_STA_BTN
SELECTOR_BTN_END=S_WORK_END_BTN

# 출퇴근 팝업 저장 셀렉터
SELECTOR_POPUP_SAVE_BTN=input.save